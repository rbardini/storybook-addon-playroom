{
  "name": "storybook-addon-playroom",
  "version": "0.0.0-development",
  "description": "Design with Playroom from Storybook, using each story source as a starting point",
  "keywords": [
    "storybook-addon",
    "design",
    "playroom",
    "react",
    "jsx"
  ],
  "homepage": "https://github.com/rbardini/storybook-addon-playroom",
  "bugs": {
    "url": "https://github.com/rbardini/storybook-addon-playroom/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rbardini/storybook-addon-playroom.git"
  },
  "license": "MIT",
  "author": {
    "name": "Rafael Bardini",
    "email": "rafael@rbardini.com",
    "url": "https://rbardini.com/"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    },
    "./manager": "./dist/manager.js",
    "./package.json": "./package.json"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "manager.js",
    "preview.js",
    "*.d.ts"
  ],
  "scripts": {
    "prebuild": "npm run clean",
    "build": "tsdown",
    "build:watch": "npm run build -- --watch",
    "build-playroom": "playroom build",
    "build-storybook": "storybook build",
    "clean": "rimraf ./dist",
    "format": "prettier --ignore-path .gitignore --write .",
    "format-check": "prettier --ignore-path .gitignore --check .",
    "package-check": "package-check",
    "playroom": "playroom",
    "prepare": "husky",
    "start": "concurrently \"npm run build:watch\" \"npm run storybook -- --quiet\" \"npm run playroom\"",
    "storybook": "storybook dev -p 6006",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "playroom": "^1.0.0",
    "react-element-to-jsx-string": "^17.0.0"
  },
  "devDependencies": {
    "@skypack/package-check": "^0.2.0",
    "@storybook/react-vite": "next",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^10.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^17.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-packagejson": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.0.0",
    "storybook": "next",
    "style-loader": "^4.0.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  },
  "peerDependencies": {
    "storybook": "^11.0.0"
  },
  "bundler": {
    "managerEntries": [
      "src/manager.tsx"
    ],
    "previewEntries": [
      "src/preview.ts",
      "src/index.ts"
    ]
  },
  "storybook": {
    "displayName": "Playroom",
    "supportedFrameworks": [
      "react"
    ],
    "icon": "https://raw.githubusercontent.com/rbardini/storybook-addon-playroom/HEAD/icon.png"
  }
}
